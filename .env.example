# Hena environment configuration
# Replace placeholders with values from your own Supabase projects.
# Never put a Supabase service_role or secret key in the Flutter client.

SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_LOCAL_KEY

SUPABASE_PRODUCTION_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PRODUCTION_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PRODUCTION_KEY